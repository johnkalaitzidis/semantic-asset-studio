{
  "name": "semantic-asset-studio",
  "productName": "Semantic Asset Studio",
  "version": "0.1.0",
  "description": "Desktop studio for generative character assets: library, parametric compare, and lineage.",
  "author": "John",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "example-library": "node scripts/build-example-library.mjs",
    "icons": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@xyflow/react": "^12.8.4",
    "chokidar": "^4.0.3",
    "exifr": "^7.1.3",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "studio.semanticasset.app",
    "productName": "Semantic Asset Studio",
    "copyright": "Copyright © 2026 John",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "example-library",
        "to": "example-library"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Semantic Asset Studio",
      "uninstallDisplayName": "Semantic Asset Studio",
      "artifactName": "Semantic Asset Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Semantic Asset Studio-Portable-${version}.${ext}"
    }
  }
}
